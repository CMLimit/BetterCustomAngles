<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BetterCustomAngles</AssemblyName>
    <RootNamespace>BetterCustomAngles</RootNamespace>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
    <ADOFAI_PATH Condition="'$(ADOFAI_PATH)' == ''">C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice</ADOFAI_PATH>
    <MANAGED_PATH>$(ADOFAI_PATH)\A Dance of Fire and Ice_Data\Managed</MANAGED_PATH>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="decompiled\**\*.cs" />
    <Compile Remove="source\**\*.cs" />
    <Compile Remove="dist\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MANAGED_PATH)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MANAGED_PATH)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MANAGED_PATH)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(MANAGED_PATH)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(MANAGED_PATH)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(MANAGED_PATH)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(MANAGED_PATH)\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(MANAGED_PATH)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(MANAGED_PATH)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(MANAGED_PATH)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(MANAGED_PATH)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MANAGED_PATH)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(MANAGED_PATH)\RDTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(MANAGED_PATH)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MANAGED_PATH)\UnityModManager\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <LangFiles Include="$(ProjectDir)Lang\*.json" />
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployMod)' == 'true'">
    <MakeDir Directories="$(ADOFAI_PATH)\Mods\BetterCustomAngles" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ADOFAI_PATH)\Mods\BetterCustomAngles" />
    <Copy SourceFiles="$(ProjectDir)Info.json" DestinationFolder="$(ADOFAI_PATH)\Mods\BetterCustomAngles" />
    <MakeDir Directories="$(ADOFAI_PATH)\Mods\BetterCustomAngles\Lang" />
    <Copy SourceFiles="@(LangFiles)" DestinationFolder="$(ADOFAI_PATH)\Mods\BetterCustomAngles\Lang" />
  </Target>

</Project>
